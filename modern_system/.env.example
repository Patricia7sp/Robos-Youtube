# Arquivo de exemplo para configuração de variáveis de ambiente
# Renomeie para .env e preencha com suas chaves de API

# API do Qwen2.5 (para processamento de texto e geração de imagens)
QWEN_API_KEY=sua_chave_api_qwen_aqui

# APIs alternativas (opcional)
OPENAI_API_KEY=sua_chave_api_openai_aqui
ANTHROPIC_API_KEY=sua_chave_api_anthropic_aqui
STABILITY_API_KEY=sua_chave_api_stability_aqui

# APIs de Animação
RUNWAY_API_KEY=sua_chave_api_runway_aqui
DID_API_KEY=sua_chave_api_did_aqui

# APIs de Áudio e Voz
ELEVENLABS_API_KEY=sua_chave_api_elevenlabs_aqui
MUBERT_API_KEY=sua_chave_api_mubert_aqui

# API do YouTube
YOUTUBE_API_KEY=sua_chave_api_youtube_aqui
YOUTUBE_CLIENT_ID=seu_client_id_youtube_aqui
YOUTUBE_CLIENT_SECRET=seu_client_secret_youtube_aqui
